rules_version = '2';

// Deployed with `firebase deploy --only firestore:rules` (see firebase.json).
service cloud.firestore {
  match /databases/{database}/documents {

    // The exercise catalog: public content, read by the app, written only by
    // tool/seed_firestore.dart (which uses the project owner's credentials, not these rules).
    match /exercises/{id} {
      allow read;
    }
    match /muscles/{id} {
      allow read;
    }
    match /routines/{id} {
      allow read;
    }
    match /moves/{id} {
      allow read;
    }
    match /meta/{id} {
      allow read;
    }

    // Each user's profile (on users/{uid}) and log (sets, sessions, meals under it): only that
    // user, signed in anonymously by the app, can read or change it.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
